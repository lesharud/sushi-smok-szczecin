# Server only. Set locally in .env.local and in Vercel. NEVER prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is supported as a server-only fallback.
# Build-time canonical URL, set to the restaurant's final domain.
SITE_URL=
# Keep false for client previews. Enable only after content and launch approval.
VITE_SITE_INDEXABLE=false

# Public Supabase values for STAFF login only; NOT the server secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stage 3 — server only. Telegram stays disabled if either value is missing.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Random 32+ characters, shared only between Vercel and Supabase Vault scheduler.
NOTIFICATION_WORKER_SECRET=
# SMS has no provider/credentials and is always disabled in Stage 3.
