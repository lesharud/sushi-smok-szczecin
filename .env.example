# Server only. Set locally in .env.local and in Vercel. NEVER prefix secrets with VITE_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy SUPABASE_SERVICE_ROLE_KEY is supported as a server-only fallback.
# Build-time canonical URL, set to the restaurant's final domain.
SITE_URL=
# Keep false for client previews. Enable only after content and launch approval.
VITE_SITE_INDEXABLE=false
